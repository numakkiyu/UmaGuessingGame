# 复制本文件为 .env 后再修改，正式环境不要直接使用示例值。
# 除了公开站点地址外，密钥、数据库和缓存地址都应按你的部署环境调整。

# =========================
# 基础运行环境
# =========================
# 当前环境，可选 development / preview / production
APP_ENV=development
# 网站对外访问地址，用于分享链接和回调地址
APP_BASE_URL=http://localhost:3000
# 应用签名密钥，生产环境必须修改成你自己的随机长字符串
APP_SIGNING_SECRET=
# 静态资源基础地址，默认和网站主地址一致
ASSET_BASE_URL=http://localhost:3000

# =========================
# 数据库与缓存
# =========================
# PostgreSQL 连接地址
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/umaguessinggame
# Redis 连接地址
REDIS_URL=redis://redis:6379

# =========================
# 人机验证与限流
# =========================
# 是否启用 Cloudflare Turnstile
TURNSTILE_ENABLED=true
# Turnstile 站点公钥，前端会用到。这里默认填的是 Cloudflare 官方测试公钥
TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Turnstile 私钥，只允许服务端使用。这里默认填的是 Cloudflare 官方测试私钥
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# 是否启用 Redis 限流
RATE_LIMIT_ENABLED=true

# =========================
# 游戏玩法开关
# =========================
# 单局最大猜测次数
MAX_GUESSES=8
# 是否开放多人匹配
ENABLE_MULTIPLAYER=true
# 是否开放好友对战
ENABLE_FRIEND_BATTLE=true
# 是否开放分享功能
ENABLE_SHARE=true

# =========================
# 图片代理与缓存
# =========================
# 是否启用项目内图片代理
ASSET_PROXY_ENABLED=true
# 图片缓存目录
ASSET_CACHE_DIR=public/assets
# 图片缓存有效期，单位秒
ASSET_CACHE_TTL_SECONDS=86400
# 图片回源超时时间，单位毫秒
ASSET_PROXY_TIMEOUT_MS=8000

# =========================
# 本地降级开关
# =========================
# 当数据库不可用时，是否允许退回本地文件存储
LOCAL_GAME_STORE_ENABLED=false

# =========================
# 实时同步
# =========================
# 预留的 WebSocket 地址，不填则仅使用当前轮询方案
REALTIME_WS_URL=
# 房间同步轮询间隔，单位毫秒
ROOM_SYNC_POLL_INTERVAL_MS=2500
# 房间在线心跳间隔，单位毫秒
REALTIME_HEARTBEAT_INTERVAL_MS=15000

# =========================
# 多人 / 好友房参数
# =========================
# 匹配池最大等待时间，单位秒
MATCHMAKING_MAX_WAIT_SECONDS=180
# 匹配成功后双方确认开始的时间，单位秒
MATCH_ACCEPT_CONFIRM_SECONDS=10
# 对战局在无操作时的超时结束时间，单位秒
MATCH_BATTLE_IDLE_TIMEOUT_SECONDS=60
# 是否允许对战中发起暂停
MATCH_PAUSE_ENABLED=true
# 对战中暂停持续时间，单位秒
MATCH_PAUSE_DURATION_SECONDS=50
# 是否允许好友房暂停
ROOM_PAUSE_ENABLED=true
# 好友房暂停持续时间，单位秒
ROOM_PAUSE_DURATION_SECONDS=50
# 新一局确认等待时间，单位秒
ROOM_REMATCH_CONFIRM_TIMEOUT_SECONDS=20
