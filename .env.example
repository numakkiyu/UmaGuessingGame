# UmaGuessingGame v2 配置示例
#
# Compose 自动读取 .env；直接运行 Go 时需显式导出变量或传入参数。
# v2 默认只需要一个 Go 进程和一块本地磁盘：没有 PostgreSQL，没有 Redis。
# 下列为直接运行的配置示例；Compose 只传入其 environment 中列出的变量。

# =========================
# 网络与监听
# =========================

# 直接运行默认 127.0.0.1:8080；此示例开放网卡，供局域网访问
# 局域网活动要监听 0.0.0.0 才能被其他手机访问：
#   UMA_ADDR=0.0.0.0:8080
# 只在本机调试用 127.0.0.1:8080。
UMA_ADDR=:8080

# Docker 部署时映射到宿主机的端口（8080）。
# 只在 `docker compose` 下生效；直接用 `make dev` 或跑二进制时改上面的 UMA_ADDR。
# 宿主 8080 常被占用（本项目的 make dev 自己就占它），换端口：
#   UMA_HOST_PORT=9080 docker compose up -d
# 换了端口不需要再手改 Origin：UMA_PUBLIC_ORIGIN 与 UMA_ALLOWED_ORIGINS 的默认值
# 会跟着这个端口走。只有用域名或反向代理时，才需要显式设置这两个变量。
# UMA_HOST_PORT=8080
# UMA_PUBLIC_ORIGIN=http://localhost:8080
# UMA_ALLOWED_ORIGINS=http://localhost:8080

# 部署模式：internet 或 lan；留空使用所选 JSON，未选文件时默认 lan
# internet 要求 HTTPS + Secure Cookie；lan 允许受控的 HTTP 例外。
UMA_DEPLOYMENT=

# 允许的同源列表，逗号分隔（空 = 用请求的 Host）
# 生产必须填写玩家实际打开的地址，否则写操作会因 Origin 不匹配被拒绝：
#   UMA_ALLOWED_ORIGINS=https://uma.example.com
UMA_ALLOWED_ORIGINS=

# 是否信任反向代理的 X-Forwarded-For（false）
# 只有确实在可信反向代理后面时才开启，否则限流可被伪造头绕过。
# 开启后必须填写下面的可信网段，否则服务拒绝启动。
UMA_TRUST_PROXY=false

# 可信反向代理网段，逗号分隔（空）
# 仅在 UMA_TRUST_PROXY=true 时生效；只写真正位于本服务前面的代理网段，
# 不要写 0.0.0.0/0 或 ::/0（启动会拒绝），最多 64 条。
# 容器内看到的直连来源是 Docker 网桥地址，与宿主视角不同；请按容器视角填写。
# 优先级：部署 JSON < 环境变量 < 显式参数；Compose 用空值透传，不覆盖 JSON。
UMA_TRUSTED_PROXY_CIDRS=

# 允许缺少 Origin 头的写请求（false）
# 仅供受控的非浏览器客户端在私网使用。浏览器写请求总会带 Origin。
UMA_ALLOW_MISSING_ORIGIN=false

# 标记 Cookie 为 Secure（false）
# 公网 HTTPS 部署必须设为 true。
UMA_SECURE_COOKIES=false

# =========================
# 数据与内容
# =========================

# SQLite 数据目录（./data/runtime）
# 必须是本机文件系统。禁止指向 NFS/SMB/NAS 共享目录——WAL 锁在网络文件系统上不可靠。
UMA_DATA_DIR=./data/runtime

# 编译后的内容包目录（./content）
# 由 `make content-compile` 生成，只读挂载。
UMA_CONTENT_DIR=./content

# 前端构建产物目录（./web/dist）
# 由 `pnpm --dir web build` 生成。
UMA_WEB_DIR=./web/dist

# 备份目录（./backups）
UMA_BACKUP_DIR=./backups

# =========================
# 存储调优（默认值适用于目标机，改前先压测）
# =========================

# SQLite synchronous 模式（FULL）
# 正式活动保持 FULL。改成 NORMAL 会在断电时丢失已确认提交，不要为性能擅自改。
UMA_SYNCHRONOUS=FULL

# 读连接池大小（8）
UMA_READ_CONNS=8

# 忙等待超时（1000ms）
# 必须小于 HTTP 请求超时，让数据库忙时先报自己的错。
UMA_BUSY_TIMEOUT=1s

# 每房间命令队列容量（128）
UMA_QUEUE_CAPACITY=128

# 会话有效期（168h = 7 天）
UMA_SESSION_TTL=168h

# 展示端会话有效期（12h）
UMA_DISPLAY_TTL=12h

# 应用优雅关闭等待（15s）；容器 stop_grace_period 应更长
UMA_SHUTDOWN_GRACE=15s

# =========================
# 观测
# =========================

# 日志级别：debug / info / warn / error（info）
UMA_LOG_LEVEL=info

# /metrics 仅本机可访问（true）
# 公网部署保持 true，不要让指标端点暴露给公众。
UMA_METRICS_LOCAL_ONLY=true

# =========================
# 玩法与容量配置
# =========================
# 命令行 --config > UMA_CONFIG。文件 deploymentMode < UMA_DEPLOYMENT < --deployment。
# 直接运行可用 ./config/lan.json；Docker 内使用 /etc/umaguess/lan.json。
# 云端改用 /etc/umaguess/cloud.json，同时设置 HTTPS Origin 与 Secure Cookie。
# 不要将本机 ./config 路径当成容器内路径。
# UMA_CONFIG=/etc/umaguess/lan.json
# 文件中 forms 控制游玩形式；modes 按玩法进一步限制，任意一层 false 都关闭。
# 修改文件后重启生效。关闭禁止新局，已确认结果和在途对局仍可恢复。

# 可选入场验证：在 UMA_CONFIG 指定的 JSON 中设置 turnstile.enabled=true、
# siteKey、hostnames（仅主机名，无端口），secretEnv 默认读取下方变量。
# 密钥只留在部署环境，不写到 config/*.json、前端或 Git。
# 关闭时不加载验证脚本；独立练习不需要验证。
UMA_TURNSTILE_SECRET=


# 可选 Docker 构建参数（仅在默认镜像/依赖代理无法访问时显式选择）
# 默认运行镜像是 gcr.io/distroless/static-debian12:nonroot。
# UMA_RUNTIME_IMAGE=debian:trixie-slim
# UMA_BUILD_GO_PROXY=https://goproxy.cn,direct

# Turnstile 开启时可在配置 JSON 中调整 adaptive、riskThreshold、riskWindowSeconds。
# 默认连续 60 秒内 6 次会话自身限流拒绝后要求重新确认；正常通行默认 900 秒。
# 测试键只用于本地接入验收，不能作为生产环境的机器人防护。
