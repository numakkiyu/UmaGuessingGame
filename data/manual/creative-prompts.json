  "constraints": [
    {
      "constraintId": "ct-01",
      "text": "整段不能出现「跑」字",
      "provenance": {
        "kind": "authored-design-value",
        "notOfficialData": true,
        "author": "modes-g08-g15",
        "basis": "docs/玩法与规则.md"
      }
    },
    {
      "constraintId": "ct-02",
      "text": "必须以一个问题结尾",
      "provenance": {
        "kind": "authored-design-value",
        "notOfficialData": true,
        "author": "modes-g08-g15",
        "basis": "docs/玩法与规则.md"
      }
    },
    {
      "constraintId": "ct-03",
      "text": "必须包含一个具体的数字",
      "provenance": {
        "kind": "authored-design-value",
        "notOfficialData": true,
        "author": "modes-g08-g15",
        "basis": "docs/玩法与规则.md"
      }
    },
    {
      "constraintId": "ct-04",
      "text": "只能写一件事，不能转折",
      "provenance": {
        "kind": "authored-design-value",
        "notOfficialData": true,
        "author": "modes-g08-g15",
        "basis": "docs/玩法与规则.md"
      }
    },
    {
      "constraintId": "ct-05",
      "text": "必须用第二人称「你」",
      "provenance": {
        "kind": "authored-design-value",
        "notOfficialData": true,
        "author": "modes-g08-g15",
        "basis": "docs/玩法与规则.md"
      }
    },
    {
      "constraintId": "ct-06",
      "text": "不能出现任何人的名字",
      "provenance": {
        "kind": "authored-design-value",
        "notOfficialData": true,
        "author": "modes-g08-g15",
        "basis": "docs/玩法与规则.md"
      }
    },
    {
      "constraintId": "ct-07",
      "text": "必须提到一件道具",
      "provenance": {
        "kind": "authored-design-value",
        "notOfficialData": true,
        "author": "modes-g08-g15",
        "basis": "docs/玩法与规则.md"
      }
    },
    {
      "constraintId": "ct-08",
      "text": "只能写一句话，不得分段",
      "provenance": {
        "kind": "authored-design-value",
        "notOfficialData": true,
        "author": "modes-g08-g15",
        "basis": "docs/玩法与规则.md"
      }
    },
    {
      "constraintId": "ct-09",
      "text": "必须出现一个时间点",
      "provenance": {
        "kind": "authored-design-value",
        "notOfficialData": true,
        "author": "modes-g08-g15",
        "basis": "docs/玩法与规则.md"
      }
    },
    {
      "constraintId": "ct-10",
      "text": "不能使用感叹号",
      "provenance": {
        "kind": "authored-design-value",
        "notOfficialData": true,
        "author": "modes-g08-g15",
        "basis": "docs/玩法与规则.md"
      }
    },
    {
      "constraintId": "ct-11",
      "text": "必须以「后来」开头",
      "provenance": {
        "kind": "authored-design-value",
        "notOfficialData": true,
        "author": "modes-g08-g15",
        "basis": "docs/玩法与规则.md"
      }
    },
    {
      "constraintId": "ct-12",
      "text": "必须包含一句对话",
      "provenance": {
        "kind": "authored-design-value",
        "notOfficialData": true,
        "author": "modes-g08-g15",
        "basis": "docs/玩法与规则.md"
      }
    }
  ]
