{
  "name": "@umaguess/web",
  "version": "2.0.0-draft.1",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-concentration.mjs --check && tsc -b --noEmit && vite build",
    "size": "node scripts/check-size.mjs",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "node tools/toolchain/run-eslint.mjs && node scripts/check-classnames.mjs",
    "api:types": "pnpm --dir tools/toolchain exec openapi-typescript ../../../api/openapi.json -o ../../src/lib/api/schema.d.ts",
    "api:check": "node scripts/check-api-drift.mjs",
    "test": "vitest run && node --test scripts/test/*.test.mjs",
    "api:install": "pnpm --dir tools/toolchain install",
    "copy:check": "node scripts/check-player-copy.mjs",
    "check:classnames": "node scripts/check-classnames.mjs",
    "audit:fields": "node scripts/audit-projection-fields.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "i18next": "27.1.1",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.1",
    "react-router": "8.5.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.0",
    "playwright": "1.58.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "3.2.4"
  }
}
