{
  "name": "uma-guessing-game",
  "version": "2.0.0-draft.1",
  "private": true,
  "description": "UmaGuessingGame v2: React SPA + Go modular monolith + SQLite",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "repo:check": "node web/scripts/check-repository.mjs",
    "audio:verify": "go run ./cmd/content audio-verify",
    "dev:web": "pnpm --dir web run dev",
    "build:web": "pnpm --dir web run build",
    "typecheck:web": "pnpm --dir web run typecheck",
    "lint:web": "pnpm --dir web run lint",
    "test:web": "pnpm --dir web run test",
    "api:types": "pnpm --dir web run api:types",
    "api:check": "pnpm --dir web run api:check",
    "audit:layout": "node web/scripts/audit-layout.mjs",
    "dev:server": "go run ./cmd/server",
    "build:server": "go build -o bin/uma-server ./cmd/server",
    "test:server": "go test ./... -count=1",
    "test:server:race": "go test ./... -count=1 -race",
    "vet:server": "go vet ./...",
    "content:compile": "go run ./cmd/content build --out content",
    "content:verify": "go run ./cmd/content verify --out content",
    "check": "pnpm run typecheck:web && pnpm run lint:web && pnpm run test:web && pnpm run build:web && go vet ./... && go test ./... -count=1",
    "ci": "pnpm run api:check && pnpm run check",
    "docs:dev": "pnpm --dir docs run dev",
    "docs:build": "pnpm --dir docs run build",
    "docs:preview": "pnpm --dir docs run preview",
    "docs:check": "pnpm --dir docs run check"
  }
}
