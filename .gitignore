# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# runtime asset cache
/public/assets/characters/thumbnails/*
!/public/assets/characters/thumbnails/.gitkeep
/public/assets/characters/portraits/*
!/public/assets/characters/portraits/.gitkeep

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-server*.log
prod-server*.log

# local runtime and review files
data/runtime/
*-review.png
*-check.png

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local AI collaboration files
AGENTS.md
plan.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
