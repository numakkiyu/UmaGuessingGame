# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# runtime asset cache
/public/assets/characters/thumbnails/*
!/public/assets/characters/thumbnails/.gitkeep
/public/assets/characters/portraits/*
!/public/assets/characters/portraits/.gitkeep

# production
/build
/dist/

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
*.log
*.swp
*.swo
.idea/
.vscode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-server*.log
prod-server*.log

# local runtime and review files
data/runtime/
*-review.png
*-check.png
.publish-temp/
.publish-temp.zip

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Private workspace files
AGENTS.md
plan.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local caches
/.cache/

# ---- UmaGuessingGame v2 (Go + Vite) ----------------------------------------
# Go build output
/bin/
*.test
coverage.out

# Vite build output is regenerated; the Go server embeds/serves web/dist
/web/dist/
/web/node_modules/
/internal/spafs/dist/*
!/internal/spafs/dist/.gitkeep

# Local runtime state: never commit a database or its WAL/SHM sidecars
/.cache/runtime/
/runtime.db
/runtime.db-shm
/runtime.db-wal
/server.lock
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
server.lock
config/*.local.json

# Compiled content packs are build artefacts derived from data/.
# The manifest is reproducible via `make content-compile`.
/content/pack-*/
/content/current

# Local backups
/backups/

# Ignore bulk audio downloads; reviewed clips need per-file exceptions
# Exclude children, not the directory, so the manifest exception can match
/data/assets/audio/*
!/data/assets/audio/manifest.json

# Test reports and browser downloads
coverage/
playwright-report/
test-results/
.playwright/

# Private workspace directories, including nested paths
.agent/

# Default output names from direct Go builds
/server
/uma-server
/uma-content
